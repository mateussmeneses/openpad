<Window x:Class="OpenPad.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OpenPad.App.ViewModels"
        mc:Ignorable="d"
        Title="OpenPad — Mapeamento de Gamepads para PC"
        Height="780" Width="1050"
        MinHeight="600" MinWidth="850"
        Background="#18191E"
        Foreground="#ECEFF4"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Estilos de controles -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable, sans-serif"/>
        </Style>

        <Style x:Key="HeaderTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#00E5FF"/>
        </Style>

        <Style x:Key="CardPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#22242C"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#323644"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E3440"/>
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Setter Property="BorderBrush" Value="#4C566A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ArmButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>

        <Style x:Key="DisarmButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="BorderBrush" Value="#EF5350"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>

        <Style x:Key="ControllerButtonBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderBrush" Value="#4C566A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Top bar -->
            <RowDefinition Height="Auto"/>
            <!-- Controller info bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content (Monitor + Editor) -->
            <RowDefinition Height="*"/>
            <!-- Diagnostics Log -->
            <RowDefinition Height="150"/>
            <!-- Status bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Bar -->
        <Border Grid.Row="0" Style="{StaticResource CardPanelStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎮 OpenPad" Style="{StaticResource HeaderTitleStyle}" Margin="0,0,16,0"/>
                    <Border CornerRadius="4" Background="{Binding ArmedStatusColor}" Padding="10,4" Margin="0,0,12,0">
                        <TextBlock Text="{Binding ArmedStatusText}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="⚡ ATIVAR / DESATIVAR" Command="{Binding ToggleArmedCommand}"
                            Style="{StaticResource ArmButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="🚨 EMERGÊNCIA: DESARMAR" Command="{Binding EmergencyDisarmCommand}"
                            Style="{StaticResource DisarmButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Controller Info Bar -->
        <Border Grid.Row="1" Style="{StaticResource CardPanelStyle}" Margin="0,0,0,12" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Dispositivo: " FontWeight="SemiBold" Foreground="#88C0D0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding ControllerName}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="6,0,0,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Status: " Foreground="#88C0D0" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#A3BE8C"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Main Center Split (Monitor + Mapping Editor) -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 3A. Monitor ao Vivo do Gamepad -->
            <Border Grid.Column="0" Style="{StaticResource CardPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Monitor em Tempo Real (SDL3)" FontSize="15" FontWeight="SemiBold" Foreground="#88C0D0" Margin="0,0,0,10"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Face buttons -->
                            <TextBlock Text="Botões de Ação:" FontWeight="SemiBold" Margin="0,6,0,4"/>
                            <WrapPanel Margin="0,0,0,8">
                                <Border Style="{StaticResource ControllerButtonBadge}" Background="{Binding BtnA, Converter={x:Null}}">
                                    <TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                                <Border Style="{StaticResource ControllerButtonBadge}">
                                    <TextBlock Text="B" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                                <Border Style="{StaticResource ControllerButtonBadge}">
                                    <TextBlock Text="X" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                                <Border Style="{StaticResource ControllerButtonBadge}">
                                    <TextBlock Text="Y" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                            </WrapPanel>

                            <!-- Shoulders & Menu -->
                            <TextBlock Text="Gatilhos e Sistema:" FontWeight="SemiBold" Margin="0,6,0,4"/>
                            <WrapPanel Margin="0,0,0,8">
                                <Border Style="{StaticResource ControllerButtonBadge}"><TextBlock Text="LB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <Border Style="{StaticResource ControllerButtonBadge}"><TextBlock Text="RB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <Border Style="{StaticResource ControllerButtonBadge}"><TextBlock Text="Back" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <Border Style="{StaticResource ControllerButtonBadge}"><TextBlock Text="Start" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <Border Style="{StaticResource ControllerButtonBadge}"><TextBlock Text="Guide" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            </WrapPanel>

                            <!-- D-Pad -->
                            <TextBlock Text="Direcional Digital (D-Pad):" FontWeight="SemiBold" Margin="0,6,0,4"/>
                            <WrapPanel Margin="0,0,0,8">
                                <Border Style="{StaticResource ControllerButtonBadge}"><TextBlock Text="⬆ Cima" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/></Border>
                                <Border Style="{StaticResource ControllerButtonBadge}"><TextBlock Text="⬇ Baixo" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/></Border>
                                <Border Style="{StaticResource ControllerButtonBadge}"><TextBlock Text="⬅ Esq" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/></Border>
                                <Border Style="{StaticResource ControllerButtonBadge}"><TextBlock Text="➡ Dir" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/></Border>
                            </WrapPanel>

                            <!-- Analógicos & Gatilhos -->
                            <TextBlock Text="Gatilhos Analógicos:" FontWeight="SemiBold" Margin="0,6,0,4"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="LT (Gatilho Esq)" FontSize="11" Foreground="#D8DEE9"/>
                                    <ProgressBar Height="10" Minimum="0" Maximum="100" Value="{Binding TriggerLT}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="RT (Gatilho Dir)" FontSize="11" Foreground="#D8DEE9"/>
                                    <ProgressBar Height="10" Minimum="0" Maximum="100" Value="{Binding TriggerRT}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Analógicos (Eixos X / Y):" FontWeight="SemiBold" Margin="0,6,0,4"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Stick Esquerdo (LS)" FontSize="11" Foreground="#D8DEE9"/>
                                    <ProgressBar Height="8" Minimum="-100" Maximum="100" Value="{Binding AxisLX}" Margin="0,2,0,0"/>
                                    <ProgressBar Height="8" Minimum="-100" Maximum="100" Value="{Binding AxisLY}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Stick Direito (RS)" FontSize="11" Foreground="#D8DEE9"/>
                                    <ProgressBar Height="8" Minimum="-100" Maximum="100" Value="{Binding AxisRX}" Margin="0,2,0,0"/>
                                    <ProgressBar Height="8" Minimum="-100" Maximum="100" Value="{Binding AxisRY}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 3B. Editor de Mapeamentos -->
            <Border Grid.Column="2" Style="{StaticResource CardPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Profile toolbar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Mappings table -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Perfil: " FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#2E3440" Foreground="#ECEFF4" BorderBrush="#4C566A"
                                 Padding="6,4" Margin="0,0,10,0" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="Salvar" Command="{Binding SaveProfileCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,6,0"/>
                            <Button Content="Carregar" Command="{Binding LoadProfileCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,6,0"/>
                            <Button Content="Padrão" Command="{Binding ResetProfileCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,6,0"/>
                            <Button Content="Aplicar" Command="{Binding ApplyBindingsCommand}" Style="{StaticResource ActionButtonStyle}"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Bindings}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              Background="#1E1F29" Foreground="#ECEFF4"
                              RowBackground="#252733" AlternatingRowBackground="#2A2D3A"
                              BorderBrush="#3B4252" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#3B4252"
                              HeadersVisibility="Column"
                              RowHeight="32">
                        <DataGrid.Columns>
                            <!-- Botão do controle -->
                            <DataGridTextColumn Header="Botão do Gamepad" Binding="{Binding ButtonName}" IsReadOnly="True" Width="150"/>

                            <!-- Tipo de ação -->
                            <DataGridTemplateColumn Header="Tipo de Saída" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableActionTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  SelectedItem="{Binding ActionType, UpdateSourceTrigger=PropertyChanged}"
                                                  Background="#2E3440" Foreground="#1E1F29" Margin="2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Tecla mapeada -->
                            <DataGridTemplateColumn Header="Tecla (Teclado)" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableKeys, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  SelectedItem="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsKeyAction}"
                                                  Background="#2E3440" Foreground="#1E1F29" Margin="2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Botão do Mouse -->
                            <DataGridTemplateColumn Header="Botão do Mouse" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableMouseButtons, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  SelectedItem="{Binding MouseButton, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsMouseAction}"
                                                  Background="#2E3440" Foreground="#1E1F29" Margin="2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Resumo -->
                            <DataGridTextColumn Header="Mapeamento Ativo" Binding="{Binding DisplayTarget}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Diagnostics Log -->
        <Border Grid.Row="3" Style="{StaticResource CardPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Log de Atividades e Diagnóstico" FontSize="13" FontWeight="SemiBold" Foreground="#88C0D0" Margin="0,0,0,6"/>

                <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}"
                         Background="#121317" Foreground="#D8DEE9" BorderBrush="#2E3440"
                         FontFamily="Consolas, monospace" FontSize="11"/>
            </Grid>
        </Border>

        <!-- 5. Footer / Status bar -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="OpenPad v0.1 | SDL3 nativo | Win32 SendInput | Sem injeção de processos ou drivers proprietários"
                       FontSize="11" Foreground="#4C566A"/>
        </StackPanel>
    </Grid>
</Window>
